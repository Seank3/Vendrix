# ────────────────────────────────────────────────────────────────
# Vendrix environment — see DEPLOYMENT.md for the full hosting guide.
# Local dev defaults live in vendrix/settings/development.py.
# ────────────────────────────────────────────────────────────────

# Core
DEBUG=False
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=vendrix-api.onrender.com,localhost

# Database — set EITHER DATABASE_URL (Render/Supabase/Railway) OR the DB_* pair.
# Supabase example: postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgres://vendrix:vendrix@localhost:5432/vendrix
DB_NAME=vendrix
DB_USER=vendrix
DB_PASSWORD=vendrix
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
VENDRIX_EVENT_BUS_BACKEND=celery

# Security
# Fernet key for integration credentials. STRONGLY required in production —
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# CORS — the exact origin(s) of your hosted frontend
CORS_ALLOWED_ORIGINS=https://vendrix-console.netlify.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=
